# Copy this file to .env.integration.local, replace every placeholder with values
# from an isolated non-production Supabase project, and chmod the local file 600.
TRAVEL_LOG_TEST_ENVIRONMENT=staging
TRAVEL_LOG_TEST_SUPABASE_URL=https://TEST_PROJECT_REF.supabase.co
TRAVEL_LOG_TEST_SUPABASE_PROJECT_REF=TEST_PROJECT_REF
TRAVEL_LOG_TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_TEST_VALUE
TRAVEL_LOG_TEST_SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_TEST_SERVICE_ROLE_VALUE
